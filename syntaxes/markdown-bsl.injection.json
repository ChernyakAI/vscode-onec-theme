{
  "scopeName": "markdown.bsl.injection",
  "injectionSelector": "L:text.html.markdown - (comment, string, markup.fenced_code.block.markdown, markup.raw.block.markdown, markup.quote.markdown, markup.list)",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)( {0,3})(`{3,})[ \\t]*((?i:1c|bsl|os))(?=[ \\t]|$)([^`]*)$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.attributes.markdown"
        }
      },
      "end": "(^|\\G)( {0,3})(\\3`*)[ \\t]*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "contentName": "meta.embedded.block.bsl source.bsl",
      "patterns": [
        {
          "include": "source.bsl"
        }
      ]
    },
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)( {0,3})(~{3,})[ \\t]*((?i:1c|bsl|os))(?=[ \\t]|$)(.*)$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.attributes.markdown"
        }
      },
      "end": "(^|\\G)( {0,3})(\\3~*)[ \\t]*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "contentName": "meta.embedded.block.bsl source.bsl",
      "patterns": [
        {
          "include": "source.bsl"
        }
      ]
    },
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)( {0,3})(`{3,})[ \\t]*((?i:sdbl))(?=[ \\t]|$)([^`]*)$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.attributes.markdown"
        }
      },
      "end": "(^|\\G)( {0,3})(\\3`*)[ \\t]*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "contentName": "meta.embedded.block.sdbl source.sdbl",
      "patterns": [
        {
          "include": "source.sdbl"
        }
      ]
    },
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)( {0,3})(~{3,})[ \\t]*((?i:sdbl))(?=[ \\t]|$)(.*)$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.attributes.markdown"
        }
      },
      "end": "(^|\\G)( {0,3})(\\3~*)[ \\t]*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "contentName": "meta.embedded.block.sdbl source.sdbl",
      "patterns": [
        {
          "include": "source.sdbl"
        }
      ]
    }
  ]
}
