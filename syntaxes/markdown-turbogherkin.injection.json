{
  "scopeName": "markdown.turbogherkin.injection",
  "injectionSelector": "L:text.html.markdown - (comment, string, markup.fenced_code.block.markdown, markup.raw.block.markdown, markup.quote.markdown, markup.list)",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)( {0,3})(`{3,})[ \\t]*((?i:feature))(?=[ \\t]|$)([^`]*)$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" },
        "5": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "end": "(^|\\G)( {0,3})(\\3`*)[ \\t]*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "contentName": "meta.embedded.block.turbogherkin source.turbogherkin",
      "patterns": [
        { "include": "source.turbogherkin" }
      ]
    },
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)( {0,3})(~{3,})[ \\t]*((?i:feature))(?=[ \\t]|$)(.*)$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" },
        "5": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "end": "(^|\\G)( {0,3})(\\3~*)[ \\t]*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "contentName": "meta.embedded.block.turbogherkin source.turbogherkin",
      "patterns": [
        { "include": "source.turbogherkin" }
      ]
    }
  ]
}
