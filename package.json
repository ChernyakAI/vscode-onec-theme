{
  "name": "onec",
  "displayName": "OneC Theme", 
  "description": "The color theme for Visual Studio Code",
  "version": "2.0.1",
  "publisher": "chernyakai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ChernyakAI/vscode-onec-theme/issues"
  },
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChernyakAI/vscode-onec-theme"
  },
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Themes"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./styles/markdown-preview.css"
    ],
    "grammars": [
      {
        "scopeName": "markdown.bsl.injection",
        "path": "./syntaxes/markdown-bsl.injection.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.bsl": "bsl",
          "meta.embedded.block.sdbl": "sdbl"
        }
      },
      {
        "scopeName": "markdown.turbogherkin.injection",
        "path": "./syntaxes/markdown-turbogherkin.injection.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.turbogherkin": "turbogherkin"
        }
      }
    ],
    "themes": [
      {
        "label": "OneC Light",
        "uiTheme": "vs",
        "path": "./themes/OneC-light-color-theme.json"
      },
      {
        "label": "OneC Yellow",
        "uiTheme": "vs",
        "path": "./themes/OneC-yellow-color-theme.json"
      },
      {
        "label": "OneC Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/OneC-dark-color-theme.json"
      },
      {
        "label": "OneC Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/OneC-midnight-color-theme.json"
      }
    ]
  },
  "icon": "images/logo.png"
}
